from flask import Flask, jsonify
from flask_sqlalchemy import SQLAlchemy
from flask_cors import CORS

app = Flask(__name__)
CORS(app) 

USER = "ma_boutique_user"
PASSWORD = "joujou" 
HOST = "127.0.0.1"
PORT = "5432"
DB_NAME = "ma_boutique_db"

app.config['SQLALCHEMY_DATABASE_URI'] = f'postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB_NAME}'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
db = SQLAlchemy(app)

class Produit(db.Model):
    __tablename__ = 'produits'
    id = db.Column(db.Integer, primary_key=True)
    nom = db.Column(db.String(100), nullable=False)
    prix = db.Column(db.Float, nullable=False)
    description = db.Column(db.Text)
    image_url = db.Column(db.String(255))

    def to_json(self):
        return {
            "id": self.id,
            "nom": self.nom,
            "prix": self.prix,
            "description": self.description,
            "image_url": self.image_url
        }

@app.route('/api/produits', methods=['GET'])
def get_produits():
    produits = Produit.query.all()
    return jsonify([p.to_json() for p in produits])

if __name__ == '__main__':
    with app.app_context():
        db.create_all() 
        
        if not Produit.query.first():
            p1 = Produit(nom="Montre Élégante", prix=450.00, description="Un style intemporel pour le quotidien.", image_url="https://unsplash.com")
            p2 = Produit(nom="Écouteurs Sans Fil", prix=299.00, description="Son haute définition et réduction de bruit.", image_url="https://unsplash.com")
            db.session.add_all([p1, p2])
            db.session.commit()
            print("🚀 Base PostgreSQL initialisée avec 2 produits de test !")
            
    app.run(debug=True, port=5000)
